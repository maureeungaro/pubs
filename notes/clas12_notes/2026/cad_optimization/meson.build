project('cad-optimization-note')

note_name = 'cad_optimization'
latexmk = find_program('latexmk')
latex_output_dir = meson.current_build_dir()
tex_sources = files(
  note_name + '.tex',
  note_name + '_preamble.tex',
  note_name + '_doc.tex',
  note_name + '_bib.tex',
)

chapter_sources = files(
  'chapters/scope.tex',
  'chapters/configuration.tex',
  'chapters/loading.tex',
  'chapters/transport.tex',
  'chapters/validation.tex',
  'chapters/beamline.tex',
  'chapters/downstream.tex',
  'chapters/exit_shield.tex',
  'chapters/ft_adjuster.tex',
  'chapters/ft_inner_shield.tex',
  'chapters/ft_bolts.tex',
  'chapters/ft_outer_flange.tex',
  'chapters/ft_outer_mount.tex',
  'chapters/ft_shield.tex',
  'chapters/ft_shield_smooth.tex',
  'chapters/moller_cone.tex',
  'chapters/downstream_joints.tex',
  'chapters/run_selection.tex',
  'chapters/cone_tip.tex',
  'chapters/ft_flange.tex',
  'chapters/extension_inner.tex',
  'chapters/extension_lead.tex',
  'chapters/extension_case.tex',
  'chapters/extension_tungsten.tex',
  'chapters/ft_joints.tex',
  'chapters/htcc.tex',
  'chapters/conclusions.tex',
  'chapters/reproducibility.tex',
)
figure_sources = files(
  'figures/ft_flange_stl_comparison.pdf',
  'figures/extension_inner_stl_comparison.pdf',
  'figures/extension_lead_stl_comparison.pdf',
  'figures/extension_case_stl_comparison.pdf',
  'figures/extension_tungsten_stl_comparison.pdf',
  'figures/ft_joint_sections_1.pdf',
  'figures/ft_joint_sections_2.pdf',
  'figures/transport_comparison.pdf',
  'figures/hardware_stl_comparison.pdf',
  'figures/nose_stl_comparison.pdf',
  'figures/cones_stl_comparison.pdf',
  'figures/apex_stl_comparison.pdf',
  'figures/downstream_stl_comparison.pdf',
  'figures/exit_stl_comparison.pdf',
  'figures/adjuster_stl_comparison.pdf',
  'figures/inner_shield_stl_comparison.pdf',
  'figures/bolts_stl_comparison.pdf',
  'figures/outer_flange_stl_comparison.pdf',
  'figures/outer_mount_stl_comparison.pdf',
  'figures/ft_shield_details.pdf',
  'figures/ft_shield_smooth_comparison.pdf',
  'figures/ft_shield_stl_comparison.pdf',
  'figures/moller_cone_stl_comparison.pdf',
  'figures/moller_cone_joint.pdf',
  'figures/downstream_joint_clearance.pdf',
  'figures/moller_cone_tip_stl_comparison.pdf',
)

custom_target(
  note_name + '.pdf',
  input: [tex_sources, chapter_sources, figure_sources],
  output: [
    note_name + '.pdf',
    note_name + '.aux',
    note_name + '.fdb_latexmk',
    note_name + '.fls',
    note_name + '.log',
    note_name + '.out',
    note_name + '.toc',
  ],
  command: [
    latexmk,
    '-cd',
    '-pdf',
    '-interaction=nonstopmode',
    '-halt-on-error',
    '-outdir=' + latex_output_dir,
    '@INPUT0@',
  ],
  build_by_default: true,
  install: true,
  install_dir: [
    meson.current_source_dir(),
    false,
    false,
    false,
    false,
    false,
    false,
  ],
)
